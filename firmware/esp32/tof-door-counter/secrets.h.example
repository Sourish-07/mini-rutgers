// Copy to secrets.h and fill in at provisioning time. secrets.h is gitignored;
// device keys are issued per node by the building gateway and live only in flash.
#pragma once

#define WIFI_SSID "campus-iot"
#define WIFI_PASS "replace-me"
// the building gateway's HTTPS host (no scheme), e.g. "gw-bsc.building.rutgers.edu"
#define GATEWAY_URL "replace-me"
// PEM of the gateway's CA, one \n-escaped string
#define GATEWAY_ROOT_CA "-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
// stable node id from docs/SENSOR_INGEST.md, e.g. "esp32-01"
#define DEVICE_ID "esp32-XX"
// 32-byte device key in hex, issued at provisioning
#define DEVICE_KEY "replace-me"
