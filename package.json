{
  "name": "campus-motion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:layout": "node scripts/check-layout.mjs",
    "check:sim": "node scripts/check-sim.mjs",
    "check:bus": "node scripts/check-bus.mjs",
    "check:iso": "node scripts/check-iso.mjs",
    "check:all": "node scripts/check-iso.mjs && node scripts/check-layout.mjs && npm run check:sim && npm run check:bus && npm test",
    "test": "node --no-experimental-strip-types node_modules/vitest/vitest.mjs run",
    "test:watch": "node --no-experimental-strip-types node_modules/vitest/vitest.mjs",
    "format": "prettier --write src scripts tests",
    "format:check": "prettier --check src scripts tests"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fast-xml-parser": "^5.11.2",
    "oxlint": "^1.81.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~6.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
